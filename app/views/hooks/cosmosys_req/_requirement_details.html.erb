<% if issue.cosmosys_requirement? %>
  <div class="box cosmosys-req-details">
    <h3><%= l(:label_cosmosys_req_fields) %></h3>
    <table class="attributes">
      <tbody>
        <tr><th><%= l(:field_rq_type) %></th><td><%= issue.rq_type.present? ? l("label_cosmosys_req_type_#{issue.rq_type}") : '-' %></td>
            <th><%= l(:field_rq_level) %></th><td><%= issue.rq_level.present? ? l("label_cosmosys_req_level_#{issue.rq_level}") : '-' %></td></tr>
        <tr><th><%= l(:field_rq_srcs) %></th><td colspan="3"><%= issue.rq_srcs.presence || '-' %></td></tr>
        <tr>
            <th><%= l(:field_rq_compl_state) %></th><td colspan="3"><%= issue.rq_compl_state.present? ? l("label_cosmosys_req_compliance_#{issue.rq_compl_state}") : '-' %></td></tr>
        <tr><th><%= l(:field_rq_verif_methods) %></th>
            <td><%= issue.rq_verif_method_values.map { |value| l("label_cosmosys_req_verification_#{value}") }.join(', ').presence || '-' %></td>
            <th><%= l(:field_rq_deriv_src) %></th>
            <td><%= issue.rq_deriv_src ? link_to_issue(issue.rq_deriv_src) : '-' %></td></tr>
        <% if issue.cosmosys_req_release_tracking? %>
          <tr><th><%= l(:field_rq_implem_progress) %></th>
              <td colspan="3"><%= issue.rq_implem_progress.present? ? l("label_cosmosys_req_progress_#{issue.rq_implem_progress}") : '-' %></td></tr>
        <% end %>
      </tbody>
    </table>
    <% if issue.rq_rationale.present? %><h4><%= l(:field_rq_rationale) %></h4><%= textilizable(issue, :rq_rationale) %><% end %>
    <% if issue.rq_verif_description.present? %><h4><%= l(:field_rq_verif_description) %></h4><%= textilizable(issue, :rq_verif_description) %><% end %>
    <% if issue.rq_compl_justif.present? %><h4><%= l(:field_rq_compl_justif) %></h4><%= textilizable(issue, :rq_compl_justif) %><% end %>
  </div>
<% end %>
